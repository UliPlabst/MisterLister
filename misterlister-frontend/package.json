{
  "name": "misterlister-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:app": "ng serve",
    "watch:app": "ng build --watch --configuration development",
    "test": "ng test",
    "build:sw": "webpack --config src/sw/webpack.config.js",
    "build:sw:prod": "webpack --config src/sw/webpack.config.js --mode production",
    "build:app": "ng build",
    "build:app:prod": "ng build --configuration production",
    "watch:sw": "webpack --config src/sw/webpack.config.js --watch",
    "start": "node scripts/parallel.js start:app watch:sw",
    "build:prod": "npm run build:app:prod && npm run build:sw:prod && node scripts/copy-sw.js",
    "predeploy": "node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "deploy": "npm run build:prod && npm run predeploy && gh-pages -d dist --cname ml.toolyard.app"
  },
  "homepage": "https://uliplabst.github.io/misterlister",
  "private": false,
  "dependencies": {
    "@angular/animations": "^19.2.6",
    "@angular/cdk": "^19.2.9",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.9",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "dexie": "^4.0.11",
    "lean-qr": "^2.7.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.7",
    "@angular/cli": "^19.2.7",
    "@angular/compiler-cli": "^19.2.0",
    "gh-pages": "^6.3.0",
    "ts-loader": "^9.5.2",
    "typescript": "~5.7.2",
    "webpack": "^5.99.6",
    "webpack-cli": "^6.0.1"
  }
}
